# Copy to .env before starting the stack:  cp .env.example .env
# These values are for local development only. Do not reuse them elsewhere.

# MySQL (write model)
MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_DATABASE=wallet_db

# RabbitMQ
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=change-me-locally

# MongoDB (read model)
MONGO_DATABASE=wallet_read
