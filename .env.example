# Copiar a .env antes de levantar el stack:  cp .env.example .env
# Estos valores son solo para desarrollo local. No reutilizar fuera de aqui.

# MySQL (write model)
MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_DATABASE=wallet_db

# RabbitMQ
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=change-me-locally

# MongoDB (read model)
MONGO_DATABASE=wallet_read
